# ------------------------------------------------------------------
# Backend environment variables — copy to .env and fill in values.
# Never commit .env.
# ------------------------------------------------------------------

# --- App / URLs ---
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
SESSION_COOKIE_NAME=scheduler_session
SESSION_TTL_DAYS=7

# --- PostgreSQL (docker-compose; host port 5433 to avoid clashing with a local PostgreSQL) ---
DATABASE_URL=postgresql://scheduler:scheduler@localhost:5433/scheduler?schema=public

# --- Redis (BullMQ + rate limiting + min-delay coordination) ---
REDIS_URL=redis://localhost:6379

# --- Elasticsearch ---
ELASTICSEARCH_URL=http://localhost:9200
EMAIL_SEARCH_INDEX=emails

# --- SMTP / Ethereal (see README: create an account at ethereal.email) ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Google OAuth (see README: Google Cloud Console setup) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# --- Slack OAuth (see README: Slack app setup) ---
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=http://localhost:3001/api/slack/callback
SLACK_BOT_SCOPES=chat:write,im:write

# --- Encryption key for tokens stored in DB (32+ char random string) ---
TOKEN_ENCRYPTION_KEY=change-me-to-a-long-random-secret

# --- Worker / scheduling policy ---
WORKER_CONCURRENCY=5
MIN_EMAIL_DELAY_MS=2000
HOURLY_EMAIL_LIMIT=100
EMAIL_MAX_ATTEMPTS=3

# --- CSV upload limits ---
MAX_RECIPIENTS_PER_FILE=5000

# --- Logging ---
LOG_LEVEL=info
